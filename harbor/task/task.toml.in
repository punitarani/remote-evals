schema_version = "1.4"
artifacts = [{ source = "/workspace/report.json", destination = "report.json" }]

[task]
name = "remote-evals/TASK_NAME"

[metadata]
TASK_METADATA

[agent]
timeout_sec = 240
AGENT_NETWORK

[environment]
workdir = "/workspace"
cpus = 2
memory_mb = 4096
storage_mb = 10240

[[environment.mcp_servers]]
name = "fli"
transport = "stdio"
MCP_COMMAND

[verifier]
timeout_sec = 30
environment_mode = "separate"

[verifier.environment]
network_mode = "no-network"
